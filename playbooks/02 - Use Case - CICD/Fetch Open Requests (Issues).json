                    "body": "{\n    \"sort\": [\n        {\n            \"field\": \"modifyDate\",\n            \"direction\": \"DESC\"\n        }\n    ],\n    \"limit\": 30,\n    \"logic\": \"AND\",\n    \"filters\": [\n        {\n            \"logic\": \"OR\",\n            \"filters\": [\n                {\n                    \"field\": \"name\",\n                    \"operator\": \"like\",\n                    \"_operator\": \"like\",\n                    \"value\": \"%Source Control (CR-%%\",\n                    \"type\": \"primitive\"\n                },\n                {\n                    \"field\": \"name\",\n                    \"operator\": \"eq\",\n                    \"_operator\": \"eq\",\n                    \"value\": \"Source Control - Development Settings\",\n                    \"type\": \"primitive\"\n                }\n            ]\n        },\n        {\n            \"field\": \"name\",\n            \"operator\": \"neq\",\n            \"_operator\": \"neq\",\n            \"value\": \"SolutionPack Export\",\n            \"type\": \"primitive\"\n        }\n    ],\n    \"__selectFields\": [\n        \"name\"\n    ]\n}",
